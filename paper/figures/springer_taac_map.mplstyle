# MTGCLM — Springer (TAAC / MAP) figure style
# Kural dokumani: sekil_stil_kurali.md. Bu dosyayi degistirmeyin; istisna gerekiyorsa
# sekil betiginde rc_context ile yerel olarak ezin ve nedenini betige yazin.

# --- Yazi tipi (Springer: Arial/Helvetica, 8-12 pt, tek sekil icinde minimum boyut farki)
font.family        : sans-serif
font.sans-serif    : Arial, Helvetica, Liberation Sans, DejaVu Sans
font.size          : 8
axes.labelsize     : 9
axes.titlesize     : 9
xtick.labelsize    : 8
ytick.labelsize    : 8
legend.fontsize    : 8
figure.titlesize   : 9
mathtext.default   : regular

# --- Ondalik ayirici: Ingilizce makale -> nokta. Turkce yerel ayar kullanilmaz.
axes.formatter.use_locale : False
axes.formatter.useoffset  : False
axes.unicode_minus        : True

# --- Cizgiler (Springer: >= 0.1 mm = 0.3 pt; burada guvenli pay birakildi)
lines.linewidth      : 1.0
lines.markersize     : 3.5
axes.linewidth       : 0.6
xtick.major.width    : 0.6
ytick.major.width    : 0.6
xtick.minor.width    : 0.4
ytick.minor.width    : 0.4
xtick.major.size     : 2.5
ytick.major.size     : 2.5
xtick.direction      : out
ytick.direction      : out
patch.linewidth      : 0.5
hatch.linewidth      : 0.5
errorbar.capsize     : 0
grid.linewidth       : 0.4
grid.color           : "#d9d9d9"

# --- Cerceve
axes.spines.top      : False
axes.spines.right    : False
axes.grid            : False
axes.edgecolor       : "#222222"
axes.labelcolor      : "#222222"
xtick.color          : "#222222"
ytick.color          : "#222222"
text.color           : "#222222"
axes.titlelocation   : left
legend.frameon       : False
legend.handlelength  : 1.4
legend.borderaxespad : 0.3

# --- Renk: Okabe-Ito (renk korlugu guvenli). Varlik->renk eslemesi springer_fig.py COLORS'tadir.
axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])
image.cmap      : cividis

# --- Duzen ve cikti. bbox 'tight' KULLANILMAZ: son genisligi degistirir.
figure.constrained_layout.use : True
figure.dpi          : 150
savefig.dpi         : 600
savefig.bbox        : standard
savefig.pad_inches  : 0.02
savefig.transparent : False
savefig.facecolor   : white
pdf.fonttype        : 42
ps.fonttype         : 42
svg.fonttype        : none
